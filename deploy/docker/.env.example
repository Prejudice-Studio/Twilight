# Docker Compose environment overrides for Twilight.
# Copy to the repository root as .env before running docker compose.

TZ=Asia/Shanghai
# Host port that publishes the frontend container's :3000.
WEBUI_PORT=3000
# Runtime upstream for the Next.js rewrite proxy; only used when
# NEXT_PUBLIC_API_URL is empty.
BACKEND_URL=http://twilight:5000
# Baked into the browser bundle at BUILD time. Leave empty for a same-origin
# deployment (browser calls /api/* and the rewrite proxies it to BACKEND_URL).
# Set it to the API origin only when frontend and API are on different domains,
# e.g. NEXT_PUBLIC_API_URL=https://twilightapi.example.com
NEXT_PUBLIC_API_URL=

# Change these before production deployment.
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>
BOT_INTERNAL_SECRET=<CHANGE_ME_RANDOM_SECRET>

# Comma-separated usernames that should become administrators after registration.
ADMIN_USERNAMES=admin
SITE_NAME=Twilight
LOG_LEVEL=info
RUNTIME_LOG_LIMIT=5000
